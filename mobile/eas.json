{
  "cli": { "version": ">= 21.0.2", "appVersionSource": "local" },
  "build": {
    "preview-ios": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "development": {
      "distribution": "internal", "environment": "development",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_API_URL": "http://192.168.15.6:8000/api/v1" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal", "environment": "preview",
      "env": { "APP_VARIANT": "preview", "EXPO_NO_DOTENV": "1", "EXPO_PUBLIC_API_URL": "https://alugfacil.net.br/api/v1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": { "APP_VARIANT": "production", "EXPO_NO_DOTENV": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
