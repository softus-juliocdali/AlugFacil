DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=alugfacil_dev
DB_USER=postgres
DB_PASS=
DB_CHARSET=UTF8

GOOGLE_MAPS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_MAX_BODY_BYTES=1048576
ASAAS_WEBHOOK_PROCESS_LIMIT=50
RESERVA_EXPIRACAO_MINUTOS=30
