APP_ENV=development
ASAAS_SUBACCOUNT_MODEL=NON_BAAS
ASAAS_ENABLE_SUBACCOUNT_CREATION=false
ASAAS_ALLOW_SANDBOX_MUTATIONS=false
ASAAS_ENFORCE_FINANCIAL_ONBOARDING=false
